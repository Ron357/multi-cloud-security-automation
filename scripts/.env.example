# Copy this file to .env and fill in your own values, or export these as
# real environment variables. Never commit a real .env file.

# AWS: usually you won't need anything here beyond AWS_PROFILE or the
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY pair boto3 already looks for.
AWS_PROFILE=default
AWS_REGION=us-east-1

# Azure / Entra ID: an app registration with UserAuthenticationMethod.Read.All
# and User.Read.All application permissions, admin-consented.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
