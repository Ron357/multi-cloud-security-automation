# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — never commit it with real account details.

location     = "eastus"
project_name = "msa"
environment  = "lab"

hub_vnet_cidr   = "10.1.0.0/16"
hub_subnet_cidr = "10.1.0.0/24"

spoke_vnet_cidr   = "10.2.0.0/16"
spoke_subnet_cidr = "10.2.0.0/24"

tags = {
  Owner = "your-name-here"
}
